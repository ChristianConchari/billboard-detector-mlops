# Plantilla de .env. No poner secretos acá: `scripts/generar_env.sh` copia este archivo a .env
# y reemplaza cada valor `generar` por uno aleatorio. .env no se versiona.

# airflow configuration
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=generar
AIRFLOW_FERNET_KEY=generar-fernet
AIRFLOW_SECRET_KEY=generar
AIRFLOW_API_JWT_SECRET=generar

# postgres configuration
PG_USER=airflow
PG_PASSWORD=generar
PG_DATABASE=airflow
PG_PORT=5432

# mlflow configuration
MLFLOW_PORT=5001
MLFLOW_S3_ENDPOINT_URL=http://s3:9000

# minio configuration (root: solo Airflow y MLflow; cada servicio tiene su usuario)
MINIO_ACCESS_KEY=minio
MINIO_SECRET_ACCESS_KEY=generar
MINIO_PORT=9000
MINIO_PORT_UI=9001
MLFLOW_BUCKET_NAME=mlflow
DATA_REPO_BUCKET_NAME=data
INFERENCE_S3_SECRET=generar
GATEWAY_S3_SECRET=generar
STREAM_S3_SECRET=generar

# gateway (único servicio expuesto: GATEWAY_BIND=127.0.0.1 para dejarlo solo local)
FASTAPI_PORT=8800
GATEWAY_BIND=0.0.0.0
GATEWAY_API_KEYS=generar
GATEWAY_ADMIN_KEYS=generar
GATEWAY_RATE_LIMIT_PER_MIN=600

# inferencia (token compartido gateway/consumidor → inference)
INFERENCE_TOKEN=generar
TORCH_NUM_THREADS=4
INFERENCE_CPUS=4
PERSIST_IMAGES_RATIO=0.1

# label studio configuration
LABEL_STUDIO_PORT=8090
LABEL_STUDIO_USERNAME=admin@vallavision.local
LABEL_STUDIO_PASSWORD=generar
