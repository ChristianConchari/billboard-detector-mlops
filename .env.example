# .env template. Do not put secrets here: `scripts/generate_env.sh` copies this file to .env
# and replaces every `generate` value with a random one. .env is not versioned.

# airflow configuration
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=generate
AIRFLOW_FERNET_KEY=generate-fernet
AIRFLOW_SECRET_KEY=generate
AIRFLOW_API_JWT_SECRET=generate

# postgres configuration
PG_USER=airflow
PG_PASSWORD=generate
PG_DATABASE=airflow
PG_PORT=5432

# mlflow configuration
MLFLOW_PORT=5001
MLFLOW_S3_ENDPOINT_URL=http://s3:9000

# minio configuration (root: Airflow and MLflow only; every service has its own user)
MINIO_ACCESS_KEY=minio
MINIO_SECRET_ACCESS_KEY=generate
MINIO_PORT=9000
MINIO_PORT_UI=9001
MLFLOW_BUCKET_NAME=mlflow
DATA_REPO_BUCKET_NAME=data
INFERENCE_S3_SECRET=generate
STREAM_S3_SECRET=generate

# gateway (the only exposed service: GATEWAY_BIND=127.0.0.1 keeps it local)
FASTAPI_PORT=8800
GATEWAY_BIND=0.0.0.0
GATEWAY_API_KEYS=generate
GATEWAY_ADMIN_KEYS=generate
GATEWAY_RATE_LIMIT_PER_MIN=600

# inference (token shared by gateway/consumer → inference)
INFERENCE_TOKEN=generate
TORCH_NUM_THREADS=4
INFERENCE_CPUS=4
